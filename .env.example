# Copy to backend/.env  (cp .env.example backend/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/woocommerce_crm?schema=public"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# If set, every /api call (except webhooks and /api/health) needs "Authorization: Bearer <token>". Set this in any shared deployment.
ADMIN_TOKEN=
WOOCOMMERCE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=change-me
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Your Business <crm@your-verified-domain.com>"
# Segment rules (see backend/src/config.js)
LOYAL_MIN_ORDERS=3
INACTIVE_AFTER_DAYS=90
